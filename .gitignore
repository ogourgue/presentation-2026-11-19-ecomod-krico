# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Downloaded sea-ice concentration files (F1; fetch with download_sic.sh,
# verify against F1_domain_map/sic_provenance.txt)
**/data/sic/

# FS2: data/aggregated.nc is committed, like the other aggregations. The
# _test file comes from --limit runs of FS2_currents/aggregate.py, and the
# checkpoint and the SLURM logs are by-products of a full run; see
# FS2_currents/README.md.
FS2_currents/data/*_test.nc
FS2_currents/data/checkpoint.npz
FS2_currents/*.out

# MS1: the one-cohort aggregation (a few hundred MB) is not committed, and
# the frames are rendered from it by MS1_outcome_movie/plot.py. See
# MS1_outcome_movie/README.md. The logs are by-products of the SLURM job.
MS1_outcome_movie/data/aggregated.nc
MS1_outcome_movie/frames/
MS1_outcome_movie/logs/
